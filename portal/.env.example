# Copy to .env and fill in. Every value here is an example.

# The NAS holding your media, and the SMB login for it.
NAS_HOST=192.168.1.10
NAS_MEDIA_SHARE=Media
NAS_MOVIES_SUBFOLDER=Movies
NAS_BACKUP_SHARE=Backups/tpdbarr
MEDIA_SMB_USER=
MEDIA_SMB_PASS=

# Host paths. Match them to what your Stash, Whisparr and NZBGet containers use.
STASH_MEDIA_DIR=/srv/docker/stash/media
ORGANIZED_SCENES_DIR=/srv/media/organized_scenes
IMPORT_FOLDER_DIR=/srv/media/import
NZBGET_MANUAL_DIR=/srv/docker/nzbget/downloads/completed/Manual
WHISPARR_V3_SCENES_DIR=/srv/docker/whisparr-v3/data/scenes
WHISPARR_V2_DATA_DIR=/srv/docker/whisparr-v2/data
PC_IMPORT_DIR=/srv/media/staging
